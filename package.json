{
  "name": "@wanaware/customer-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Content-quality checks for the public WanAware customer knowledge base",
  "scripts": {
    "check": "node scripts/validate-content.mjs",
    "check:release": "DOCS_RELEASE_MODE=live node scripts/validate-content.mjs",
    "check:media": "node scripts/validate-media-online.mjs",
    "media:frame": "node scripts/frame-screenshot.mjs",
    "media:enhance": "node scripts/enhance-screenshot.mjs",
    "media:publish": "node scripts/publish-screenshots-to-readme.mjs",
    "media:place": "node scripts/place-published-screenshots.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
