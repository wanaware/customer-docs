# Render with D2 v0.8.2 and the pinned command in CONTRIBUTING.md.
# Keep this source free of customer data and first-release-excluded features.

direction: down
grid-rows: 2
vertical-gap: 90

classes: {
  stage: {
    style: {
      fill: "#17233A"
      stroke: "#385174"
      stroke-width: 2
      border-radius: 16
      shadow: true
      font-color: "#F3F7FF"
      font-size: 24
      bold: true
    }
  }
  panel: {
    style: {
      fill: "#0F1725"
      stroke: "#385174"
      stroke-width: 2
      border-radius: 18
      shadow: true
      font-color: "#F3F7FF"
      font-size: 24
      bold: true
    }
  }
  collection: {
    style: {
      fill: "#13213A"
      stroke: "#385174"
      stroke-width: 2
      border-radius: 14
      font-color: "#F3F7FF"
      font-size: 20
      bold: true
    }
  }
  asset: {
    style: {
      fill: "#18263D"
      stroke: "#4A6284"
      stroke-width: 1
      border-radius: 10
      font-color: "#DCE5F5"
      font-size: 17
    }
  }
  structure_node: {
    style: {
      fill: "#0C5261"
      stroke: "#1A7B8D"
      stroke-width: 1
      border-radius: 12
      font-color: "#E6FCFF"
      font-size: 17
      bold: true
    }
  }
  flow: {
    style: {
      stroke: "#58759B"
      stroke-width: 3
      font-color: "#A8B8CF"
      font-size: 15
    }
  }
  attachment: {
    style: {
      stroke: "#28CAD8"
      stroke-width: 3
      font-color: "#67E6DF"
      font-size: 15
      bold: true
    }
  }
}

style: {
  fill: "#0B1018"
  stroke: "#202B3E"
  stroke-width: 2
  border-radius: 20
}

source_flow: {
  label: ""
  grid-columns: 3
  grid-gap: 72
  style.opacity: 0

  integration: Integration {
    class: stage
    width: 250
    height: 95
  }
  discovery: Discovery {
    class: stage
    width: 250
    height: 95
  }
  inventory: Inventory {
    class: stage
    width: 250
    height: 95
  }

  integration -> discovery: {
    class: flow
  }
  discovery -> inventory: {
    class: flow
  }
}

organization: {
  label: ""
  grid-columns: 2
  horizontal-gap: 76
  style.opacity: 0

  structure: Structure {
    class: panel
    grid-rows: 3
    vertical-gap: 22

    company: Company {
      class: structure_node
      width: 180
      height: 48
    }
    organization: Organization {
      class: structure_node
      width: 180
      height: 48
    }
    group: Group {
      class: structure_node
      width: 180
      height: 48
    }

    company -> organization: {
      class: flow
    }
    organization -> group: {
      class: flow
    }
  }

  element: Element · Application, Service, or Site {
    class: panel
    grid-columns: 2
    horizontal-gap: 28

    core: Collection · Core network {
      class: collection
      grid-rows: 3
      vertical-gap: 16

      router: Router · core-rtr-01 {
        class: asset
        width: 250
        height: 44
      }
      firewall: Firewall · edge-fw-02 {
        class: asset
        width: 250
        height: 44
      }
      switch: Switch · dist-sw-04 {
        class: asset
        width: 250
        height: 44
      }
    }

    app: Collection · App tier {
      class: collection
      grid-rows: 2
      vertical-gap: 16

      server: Server · web-01 {
        class: asset
        width: 250
        height: 44
      }
      database: Database · orders-db {
        class: asset
        width: 250
        height: 44
      }
    }
  }
}

source_flow.inventory -> organization.element: organize {
  class: flow
  style.stroke-dash: 4
}

organization.structure -> organization.element: Structure Tag {
  class: attachment
}
