# Render with D2 v0.8.2. Keep this source environment-neutral.

direction: down

classes: {
  start: {
    style: {
      fill: "#17233A"
      stroke: "#486488"
      stroke-width: 2
      border-radius: 14
      font-color: "#F4F7FB"
      font-size: 20
      bold: true
      shadow: true
    }
  }
  source: {
    style: {
      fill: "#13213A"
      stroke: "#385174"
      stroke-width: 2
      border-radius: 14
      font-color: "#E5ECF7"
      font-size: 18
      bold: true
    }
  }
  result: {
    style: {
      fill: "#0C5261"
      stroke: "#28CAD8"
      stroke-width: 2
      border-radius: 14
      font-color: "#E8FCFF"
      font-size: 20
      bold: true
      shadow: true
    }
  }
  note: {
    style: {
      fill: "#221E35"
      stroke: "#705B98"
      stroke-width: 2
      border-radius: 12
      font-color: "#E7DDF7"
      font-size: 16
    }
  }
  flow: {
    style: {
      stroke: "#6C87AA"
      stroke-width: 3
      font-color: "#C4D0E0"
      font-size: 14
    }
  }
}

style: {
  fill: "#0B1018"
  stroke: "#202B3E"
  stroke-width: 2
  border-radius: 20
}

asset: "Start with an eligible Asset" {
  class: start
}

graph: "Relationship Graph\nVerify the connected records" {
  class: result
}

limit: "There is no general-purpose action for drawing arbitrary Relationships." {
  class: note
}

discovered: "Discovered Relationship\nSupported source data identifies the connection" {
  class: source
}

connection: "Add Connection\nChoose target Asset, IP block, and endpoints\nReview the preview before creating" {
  class: source
}

asset -> discovered: { class: flow }
asset -> connection: { class: flow }
discovered -> graph: { class: flow }
connection -> graph: { class: flow }
graph -> limit: { class: flow; style.stroke-dash: 4 }
